# Spark 4.1 configuration for open-lakehouse.
#
# Catalogs:
#   unity   — Unity Catalog OSS, Delta tables. PRIMARY write path.
#   iceberg — Unity Catalog OSS Iceberg REST endpoint. READ-ONLY (UC OSS 0.4.x
#             exposes no Iceberg write endpoints).
#
# Copy to spark-defaults.conf and fill in your S3 credentials.

# ============================================================================
# Iceberg + Delta extensions
# ============================================================================
# Order matters: Iceberg first, Delta second.
spark.sql.extensions                      org.apache.iceberg.spark.extensions.IcebergSparkSessionExtensions,io.delta.sql.DeltaSparkSessionExtension

# ----------------------------------------------------------------------------
# unity — Unity Catalog OSS, Delta tables (PRIMARY write path)
# Tables: unity.<schema>.<table>. Requires the UC Spark connector JARs below.
# ----------------------------------------------------------------------------
spark.sql.catalog.unity                   io.unitycatalog.spark.UCSingleCatalog
spark.sql.catalog.unity.uri               http://localhost:8081
spark.sql.catalog.unity.token             not_used

# Default Spark catalog as DeltaCatalog — Delta extension functions
# (CREATE/INSERT/MERGE) need this even when operating on unity.* tables.
spark.sql.catalog.spark_catalog           org.apache.spark.sql.delta.catalog.DeltaCatalog

# ----------------------------------------------------------------------------
# iceberg — UC OSS Iceberg REST endpoint, READ-ONLY
# UC OSS 0.4.x exposes only GET endpoints for Iceberg; no table/namespace
# creation. Use for cross-engine reads of Iceberg tables created elsewhere.
# ----------------------------------------------------------------------------
spark.sql.catalog.iceberg                 org.apache.iceberg.spark.SparkCatalog
spark.sql.catalog.iceberg.catalog-impl    org.apache.iceberg.rest.RESTCatalog
spark.sql.catalog.iceberg.uri             http://localhost:8081/api/2.1/unity-catalog/iceberg
spark.sql.catalog.iceberg.warehouse       unity
spark.sql.catalog.iceberg.token           not_used

# ============================================================================
# S3 / SeaweedFS
# ============================================================================
spark.hadoop.fs.s3a.endpoint              http://localhost:8333
spark.hadoop.fs.s3a.access.key            your_access_key
spark.hadoop.fs.s3a.secret.key            your_secret_key
spark.hadoop.fs.s3a.path.style.access     true
spark.hadoop.fs.s3a.impl                  org.apache.hadoop.fs.s3a.S3AFileSystem
spark.hadoop.fs.s3a.connection.ssl.enabled false

# ============================================================================
# Azure Storage / ABFS (optional profile)
# ============================================================================
# Uncomment and fill in when running against Azure Storage / ADLS Gen2.
# Requires the hadoop-azure JAR (see Required JARs below).
#
# Replace <storage-account> with the Azure Storage account name.
#
# Option A: OAuth via service principal (recommended)
# spark.hadoop.fs.azure.account.auth.type.<storage-account>.dfs.core.windows.net OAuth
# spark.hadoop.fs.azure.account.oauth.provider.type.<storage-account>.dfs.core.windows.net org.apache.hadoop.fs.azurebfs.oauth2.ClientCredsTokenProvider
# spark.hadoop.fs.azure.account.oauth2.client.id.<storage-account>.dfs.core.windows.net <client-id>
# spark.hadoop.fs.azure.account.oauth2.client.secret.<storage-account>.dfs.core.windows.net <client-secret>
# spark.hadoop.fs.azure.account.oauth2.client.endpoint.<storage-account>.dfs.core.windows.net https://login.microsoftonline.com/<tenant-id>/oauth2/token
#
# Option B: account key auth
# spark.hadoop.fs.azure.account.key.<storage-account>.dfs.core.windows.net <account-key>
#
# Point the Iceberg warehouse at an ABFS path:
# spark.sql.catalog.iceberg.warehouse abfs://warehouse@<storage-account>.dfs.core.windows.net/
# SeaweedFS S3 returns HTTP 500 on bulk DeleteObjects and on the Hadoop
# FileOutputCommitter's directory-marker cleanup. Delete one object at a time
# and keep directory markers so recursive deletes / commits don't fail.
spark.hadoop.fs.s3a.multiobjectdelete.enable false
spark.hadoop.fs.s3a.directory.marker.retention keep

# UC stores table LOCATIONs as s3:// (no 'a'). Map that scheme to S3AFileSystem
# so Hadoop can read/write SeaweedFS regardless of how the URI is written.
spark.hadoop.fs.s3.impl                   org.apache.hadoop.fs.s3a.S3AFileSystem
spark.hadoop.fs.AbstractFileSystem.s3.impl org.apache.hadoop.fs.s3a.S3A

# ============================================================================
# Required JARs
# ============================================================================
# All downloaded by `./lakehouse setup` (scripts/tools/download-jars.sh).
# Delta is 4.2.0 — required for Spark 4.1 ABI compatibility.
# For Azure/ABFS, also add hadoop-azure-3.4.1.jar and hadoop-azure-datalake-3.4.1.jar.
spark.jars  /opt/spark/jars-extra/iceberg-spark-runtime-4.0_2.13-1.10.0.jar,/opt/spark/jars-extra/delta-spark_2.13-4.2.0.jar,/opt/spark/jars-extra/delta-storage-4.2.0.jar,/opt/spark/jars-extra/unitycatalog-spark_2.13-0.3.0.jar,/opt/spark/jars-extra/unitycatalog-client-0.3.0.jar,/opt/spark/jars-extra/hadoop-aws-3.4.1.jar,/opt/spark/jars-extra/aws-java-sdk-bundle-1.12.780.jar,/opt/spark/jars-extra/bundle-2.24.6.jar

# ============================================================================
# Performance Tuning
# ============================================================================
spark.driver.memory                       4g
spark.executor.memory                     8g
spark.executor.cores                      2
# Warehouse dir for SDP-managed tables. s3:// (not s3a://) so UC accepts it.
spark.sql.warehouse.dir                   s3://lakehouse/warehouse/sdp
# Default new tables to Delta. Parquet writes use the Hadoop FileOutputCommitter
# (_temporary staging + rename), and that rename's marker cleanup 500s on
# SeaweedFS S3. Delta writes commit directly via _delta_log — no rename.
spark.sql.sources.default                 delta

# ============================================================================
# Event Logging
# ============================================================================
spark.eventLog.enabled                    true
spark.eventLog.dir                        /opt/spark-data/logs
spark.history.fs.logDirectory             /opt/spark-data/logs
