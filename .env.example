# PostgreSQL
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432

# SeaweedFS S3
S3_ENDPOINT=http://host.docker.internal:8333
S3_ACCESS_KEY=your_access_key_here
S3_SECRET_KEY=your_secret_key_here
S3_BUCKET=lakehouse
S3_WAREHOUSE=s3a://lakehouse/warehouse

# Iceberg
ICEBERG_CATALOG_URI=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/iceberg_catalog
ICEBERG_WAREHOUSE=${S3_WAREHOUSE}

# Airflow (optional - only needed if using ./lakehouse start airflow)
# IMPORTANT: Change these defaults before deploying!
AIRFLOW_ADMIN_USER=your_airflow_user
AIRFLOW_ADMIN_PASSWORD=your_secure_password_here
# Generate Fernet key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# Azure deployment profile (optional)
# Set LAKEHOUSE_PROFILE=azure (or pass --profile azure to ./lakehouse) to target
# Azure-backed services. Use `just azure-generate-config` to produce the active
# .env.azure, spark-defaults.conf.azure, and server.properties.azure files from
# terraform-azure outputs instead of uncommenting values here.
#
# When the Azure profile is active, ./lakehouse sources .env.azure after .env,
# so Azure-specific values take precedence.
# LAKEHOUSE_PROFILE=azure

# Azure Storage (ADLS Gen2)
# AZURE_STORAGE_ACCOUNT_NAME=yourstorageaccount
# AZURE_STORAGE_CONTAINER_NAME=warehouse
# AZURE_STORAGE_BLOB_ENDPOINT=https://yourstorageaccount.blob.core.windows.net
# AZURE_STORAGE_PRIMARY_ACCESS_KEY=your_account_key
# AZURE_MLFLOW_ARTIFACTS_CONTAINER_NAME=mlflow-artifacts

# Azure Database for PostgreSQL Flexible Server
# AZURE_POSTGRES_HOST=your-postgres.postgres.database.azure.com
# AZURE_POSTGRES_PORT=5432
# AZURE_POSTGRES_DB=iceberg_catalog
# AZURE_POSTGRES_USER=lakehouse
# AZURE_POSTGRES_PASSWORD=your_secure_password

# Azure Event Hubs (Kafka-compatible endpoint)
# AZURE_EVENTHUB_NAMESPACE=your-namespace
# AZURE_EVENTHUB_NAME=lakehouse-events
# AZURE_EVENTHUB_CONNECTION_STRING=Endpoint=sb://your-namespace.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=your_key
# KAFKA_BOOTSTRAP_SERVERS=your-namespace.servicebus.windows.net:9093

# Azure Key Vault
# AZURE_KEY_VAULT_NAME=your-key-vault
# AZURE_KEY_VAULT_URI=https://your-key-vault.vault.azure.net/

# Azure Container Registry
# AZURE_ACR_LOGIN_SERVER=yourregistry.azurecr.io

# Azure Container Apps endpoints
# UNITY_CATALOG_URI=https://unity-catalog.yourapp.azurecontainerapps.io
# MLFLOW_TRACKING_URI=https://mlflow.yourapp.azurecontainerapps.io

# Azure Service Principal (used for ADLS / ABFS OAuth in Spark and Unity Catalog)
# AZURE_SP_CLIENT_ID=your-sp-client-id
# AZURE_SP_CLIENT_SECRET=your-sp-client-secret
# AZURE_TENANT_ID=your-tenant-id
